# ========== 二选一 ==========
# 本地 Ollama（默认）
# LLM_BACKEND=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:7b

# DeepSeek API（OpenAI 兼容）
LLM_BACKEND=openai_compatible
OPENAI_API_BASE=https://api.deepseek.com
OPENAI_API_KEY=sk-请换成你的密钥
OPENAI_MODEL=deepseek-chat

AGENT_MAX_TOOL_ROUNDS=5
DATABASE_PATH=./data/demo_medical.db

# 接入方服务端调用 POST /chat 时必填其一：请求头 X-Chat-Token: <值> 或 Authorization: Bearer <值>
# 留空则不校验（仅适合本机演示，勿用于公网）
CHAT_API_TOKEN=

# 工单管理台 /admin ：非空则须在请求中加 ?token= 或 X-Admin-Token（与页面里填的一致）
ADMIN_TOKEN=
# 管理台轮询建议间隔（秒），由 /admin/api/tickets 返回给前端
ADMIN_POLL_INTERVAL_SEC=2

# 微调样本 JSONL 路径（POST /admin/api/ft/sample 追加）
FINETUNE_JSONL_PATH=./data/finetune/samples.jsonl

# ========== 企业微信（自建应用 · 群聊接入）==========
# 回调 URL（HTTPS）示例（公司域名）：https://agent.gilitel.com/wecom/callback
# 本机运行可选两种接入：
# 1) Cloudflare Tunnel：docs/wecom_company_domain_cloudflare_tunnel.md
# 2) 公司 nginx + 反向隧道：docs/wecom_company_domain_local_reverse_tunnel.md
# URL、Token、EncodingAESKey 必须与企微后台「接收消息」配置完全一致
# 企业微信管理后台获取
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
# 「接收消息」回调配置的 Token / EncodingAESKey
WECOM_TOKEN=
WECOM_AES_KEY=
# 群聊中仅 @ 应用才回复（建议 true；联调后若无法识别 @ 再调整）
WECOM_ONLY_REPLY_WHEN_MENTIONED=true
